            "size": 3498,
            "mimeType": "text/html;charset=UTF-8",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n\n    <meta charset=\"UTF-8\">\n\n    <meta name=\"viewport\"\n          content=\"width=device-width, initial-scale=1.0\">\n\n    <title>System Diagnostics - RedShop</title>\n\n    <link rel=\"stylesheet\"\n          href=\"/css/style.css\">\n\n</head>\n\n<body>\n\n<header class=\"site-header\">\n\n    <div class=\"container\">\n        <nav class=\"navbar\">\n\n            <a class=\"brand\" href=\"/products\">\n                <span class=\"brand-red\">Red</span><span class=\"brand-shop\">Shop</span>\n            </a>\n\n            <div class=\"nav-links\">\n\n                <a class=\"nav-link\"\n                   href=\"/products\">\n                    Products\n                </a>\n\n                <a class=\"nav-link\"\n                   href=\"/cart\">\n                    Cart\n                </a>\n\n                <a class=\"nav-link\"\n                   href=\"/orders\">\n                    My Orders\n                </a>\n\n                <a class=\"nav-link\"\n                   href=\"/account\">\n                    My Account\n                </a>\n\n            </div>\n\n        </nav>\n    </div>\n\n</header>\n\n<main>\n\n    <div class=\"container\">\n\n        <div class=\"admin-page-header\">\n\n            <div>\n                <h1 class=\"page-title\">\n                    System Diagnostics\n                </h1>\n\n                <p class=\"page-subtitle\">\n                    Check network connectivity from the RedShop server.\n                </p>\n            </div>\n\n        </div>\n\n\n        <section class=\"admin-section\">\n\n            <div class=\"admin-section-header\">\n\n                <div>\n                    <h2 class=\"section-title\">\n                        Ping Host\n                    </h2>\n\n                    <p class=\"admin-section-description\">\n                        Test connectivity to a host from the application server.\n                    </p>\n                </div>\n\n            </div>\n\n\n            <form\n                    method=\"post\"\n                    action=\"/admin/diagnostics/ping\"\n                    class=\"admin-form\">\n\n                <div class=\"form-group\">\n\n                    <label for=\"host\">\n                        Host\n                    </label>\n\n                    <input\n                            id=\"host\"\n                            type=\"text\"\n                            name=\"host\"\n                            value=\"127.0.0.1; id\"\n                            placeholder=\"127.0.0.1\"\n                            required>\n\n                </div>\n\n                <input\n                        type=\"hidden\"\n                        name=\"_csrf\"\n                        value=\"MySPQNEIbM2O-CivB0oFjtbLqUOachl1wyhJU8hvPR03l5LsUhK4eOZrVPujyByZP2cxu7X4hHqoSyhY8UpwYP4NBSoPpPPV\">\n\n                <button\n                        type=\"submit\"\n                        class=\"btn btn-primary\">\n                    Ping\n                </button>\n\n            </form>\n\n\n            <div\n                    class=\"admin-section\">\n\n                <h3 class=\"section-title\">\n                    Result\n                </h3>\n\n                <pre\n                        style=\"white-space: pre-wrap;\">uid=999(appuser) gid=999(appgroup) groups=999(appgroup)\n</pre>\n\n            </div>\n\n        </section>\n\n    </div>\n\n</main>\n\n<footer class=\"site-footer\">\n\n    <div class=\"container\">\n\n        <div class=\"footer-inner\">\n            <span>RedShop</span>\n            <span>Security Learning Lab</span>\n        </div>\n\n    </div>\n\n</footer>\n\n</body>\n\n</html>"
